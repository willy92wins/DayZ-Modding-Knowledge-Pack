{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/dayz-modding-knowledge-pack/promotion-map.schema.json",
  "title": "DayZ Modding Knowledge Pack promotion routing",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifacts"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "artifact_id",
          "repo_path",
          "artifact_kind",
          "applicability",
          "vault_targets",
          "skill_target_ids"
        ],
        "properties": {
          "artifact_id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._/-]*$"
          },
          "repo_path": {
            "type": "string",
            "minLength": 1
          },
          "artifact_kind": {
            "enum": [
              "file",
              "tree"
            ]
          },
          "applicability": {
            "enum": [
              "domain_invariant",
              "governance",
              "tooling"
            ]
          },
          "vault_targets": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "skill_target_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "not_applicable_reason": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
